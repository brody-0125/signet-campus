<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- do_not_remove: published-with-gradle-metadata -->
<modelVersion>4.0.0</modelVersion>
  <groupId>com.github.brody-0125</groupId>
  <artifactId>signet-spring-boot-starter</artifactId>
  <version>v0.1.0</version>
  <name>brody-0125/signet-spring-boot-starter</name>
  <description>The definitive Spring Boot Starter for signet-core. providing robust auto-configuration for SVG/PNG baking and standardized API scaffolding.</description>
  <url>https://github.com/brody-0125/signet-spring-boot-starter</url>
  <inceptionYear>2026</inceptionYear>
  <developers>
    <developer>
      <id>brody-0125</id>
      <name>Seokhyeon Kim</name>
      <email></email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git://github.com/brody-0125/signet-spring-boot-starter.git</connection>
    <developerConnection>scm:git://github.com/brody-0125/signet-spring-boot-starter.git</developerConnection>
    <url>git://github.com/brody-0125/signet-spring-boot-starter.git</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>3.5.11</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>com.github.brody-0125</groupId>
      <artifactId>signet-core</artifactId>
      <version>8a98820f9c</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
